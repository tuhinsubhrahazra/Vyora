<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your progress over time"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnMonth">

                <Button
                    android:id="@+id/btnMonth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Month"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:strokeColor="@color/divider_color" />

                <Button
                    android:id="@+id/btnWeek"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Week"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:strokeColor="@color/divider_color" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </RelativeLayout>

        <!-- Stats Summary Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="73%"
                        android:textColor="@color/accent_purple"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg this month"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 5"
                        android:textColor="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Best streak"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9/13"
                        android:textColor="@color/accent_blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Days on track"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Calendar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="June 2025"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Calendar Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <!-- Days of Week -->
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="S" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="M" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="T" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="W" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="T" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="F" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" android:text="S" android:textColor="@color/text_secondary" android:textSize="10sp" />

                    <!-- Sample Days - First Row -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_orange" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="2" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_green" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_red" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="4" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_green" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="5" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_orange" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="6" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_green" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="7" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Second Row -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/accent_green" app:cardCornerRadius="6dp" app:strokeWidth="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="8" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="2dp" app:strokeColor="@color/accent_purple">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="9" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="10" android:textColor="@color/text_secondary" android:textSize="10sp" /></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="11" android:textColor="@color/text_secondary" android:textSize="10sp" /></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="12" android:textColor="@color/text_secondary" android:textSize="10sp" /></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="13" android:textColor="@color/text_secondary" android:textSize="10sp" /></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="32dp" android:layout_columnWeight="1" android:layout_margin="4dp" app:cardBackgroundColor="@color/calendar_empty" app:cardCornerRadius="6dp" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="14" android:textColor="@color/text_secondary" android:textSize="10sp" /></com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/accent_green" android:layout_gravity="center_vertical" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" >70%" android:textColor="@color/text_secondary" android:textSize="8sp" android:layout_marginEnd="12dp" />

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/accent_orange" android:layout_gravity="center_vertical" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 50-70%" android:textColor="@color/text_secondary" android:textSize="8sp" android:layout_marginEnd="12dp" />

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/accent_red" android:layout_gravity="center_vertical" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" &lt;50%" android:textColor="@color/text_secondary" android:textSize="8sp" android:layout_marginEnd="12dp" />

                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/calendar_empty" android:layout_gravity="center_vertical" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" No data" android:textColor="@color/text_secondary" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Day Detail Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunday, 8 Jun"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="73%"
                        android:textColor="@color/accent_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Tracker 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <View android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_green" android:layout_marginEnd="12dp" />
                    <ProgressBar android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:max="100" android:progress="82" android:progressDrawable="@drawable/bg_horizontal_progress_green" style="?android:attr/progressBarStyleHorizontal" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end" android:text="82%" android:textColor="@color/accent_green" android:textSize="10sp" />
                </LinearLayout>

                <!-- Tracker 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <View android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_purple" android:layout_marginEnd="12dp" />
                    <ProgressBar android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:max="100" android:progress="61" android:progressDrawable="@drawable/bg_horizontal_progress_purple" style="?android:attr/progressBarStyleHorizontal" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end" android:text="61%" android:textColor="@color/accent_purple" android:textSize="10sp" />
                </LinearLayout>

                <!-- Tracker 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    <View android:layout_width="32dp" android:layout_height="32dp" android:background="#1A2B3B" android:layout_marginEnd="12dp" />
                    <ProgressBar android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:max="100" android:progress="78" android:progressDrawable="@drawable/bg_horizontal_progress_blue" style="?android:attr/progressBarStyleHorizontal" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end" android:text="78%" android:textColor="@color/accent_blue" android:textSize="10sp" />
                </LinearLayout>

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Score delta" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="+23 pts" android:textColor="@color/accent_green" android:textSize="12sp" android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Trend -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PROGRESS TREND"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily % — past 13 days" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:orientation="horizontal">
                        <View android:layout_width="8dp" android:layout_height="2dp" android:background="@color/accent_blue" android:layout_gravity="center_vertical" android:layout_marginEnd="4dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily" android:textColor="@color/text_secondary" android:textSize="8sp" android:layout_marginEnd="8dp" />
                        <View android:layout_width="8dp" android:layout_height="2dp" android:background="@color/accent_green" android:layout_gravity="center_vertical" android:layout_marginEnd="4dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg" android:textColor="@color/text_secondary" android:textSize="8sp" />
                    </LinearLayout>
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/progressTrendChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cumulative Score -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CUMULATIVE SCORE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total score over time" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="+209 pts" android:textColor="@color/accent_green" android:textSize="12sp" android:textStyle="bold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/cumulativeScoreChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Day Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DAY LOG"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Log Item 1 -->
